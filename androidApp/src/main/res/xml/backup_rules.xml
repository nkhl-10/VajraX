<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: same scope as data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <!-- The sign-in is bound to this phone's Keystore key; a new phone signs in again. -->
    <exclude domain="sharedpref" path="vajrax_session.xml" />
</full-backup-content>
