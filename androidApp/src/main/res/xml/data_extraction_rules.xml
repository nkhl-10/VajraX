<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the habit database and settings follow the user's own device backup and
     phone-to-phone transfer, so a new phone restores routines and history. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
