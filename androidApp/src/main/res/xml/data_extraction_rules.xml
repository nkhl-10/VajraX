<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the habit database and settings follow the user's own device backup and
     phone-to-phone transfer, so a new phone restores routines and history. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- The sign-in is bound to this phone's Keystore key; a new phone signs in again. -->
        <exclude domain="sharedpref" path="vajrax_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="vajrax_session.xml" />
    </device-transfer>
</data-extraction-rules>
