# VAJRAX server settings. Copy to deploy/.env for a local container run (deploy/.env is git-ignored):
#   docker run -p 8080:8080 --env-file deploy/.env vajrax-server
# On Cloud Run, deploy/cloudbuild.yaml sets these (secrets come from Secret Manager).
# Empty or missing = the default shown.

# --- Server ---
# development | production. Production refuses a short JWT_SECRET, a non-https PUBLIC_BASE_URL and no DB password.
APP_ENV=development
PORT=8080
# Public address of the site, used in password-reset links and to decide the cookie's Secure flag.
PUBLIC_BASE_URL=http://localhost:8080
# Folder with site/ and app/ (:server:stageWeb). The image already sets /app/web; leave commented there.
# WEB_DIR=server/build/web
# Shown by GET /v1/version.
APP_VERSION=1.0.0
# The image sets the commit it was built from.
# GIT_SHA=dev
# Apps older than this are asked to update before they sync.
MIN_APP_VERSION=1.0
# Proxies that add their address after the client's in X-Forwarded-For: 0 on Cloud Run, 1 behind a load balancer.
FORWARDED_SKIP_LAST=0
# Extra browser origins allowed to call the API (comma-separated). The site and web app need none.
CORS_ORIGINS=

# --- Database (PostgreSQL; tested on 17) ---
# From inside a container, a database on your machine is host.docker.internal, not localhost.
DB_URL=jdbc:postgresql://localhost:5432/vajrax
DB_USER=vajrax
DB_PASSWORD=
# Cloud SQL "project:region:instance". When set, the Cloud SQL connector is used and DB_URL is jdbc:postgresql:///<db>.
DB_INSTANCE=
DB_POOL_SIZE=5
# Apply migrations on start (safe with several instances; one migrates at a time).
DB_MIGRATE=true

# --- Sign-in tokens ---
# At least 32 bytes in production, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=
JWT_ISSUER=vajrax
JWT_AUDIENCE=vajrax-apps
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60

# --- Email (password reset). Without SMTP_HOST no email is sent; development logs the message instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VAJRAX <no-reply@localhost>
SMTP_STARTTLS=true

# --- Operations ---
# Bearer token for GET /internal/metrics (Prometheus). Empty = endpoint off.
METRICS_TOKEN=
# Bearer token for POST /internal/jobs/maintenance (Cloud Scheduler). Empty = endpoint off.
JOBS_TOKEN=
# Daily housekeeping inside the server process (off = only the scheduled call runs it).
MAINTENANCE=on

# --- Limits per client address, per instance ---
RATE_LOGIN_PER_MINUTE=10
RATE_REGISTER_PER_HOUR=5
RATE_PASSWORD_EMAIL_PER_HOUR=3
RATE_SYNC_PER_MINUTE=120

# --- Password hashing (Argon2id) ---
ARGON2_MEMORY_KB=19456
ARGON2_ITERATIONS=2
