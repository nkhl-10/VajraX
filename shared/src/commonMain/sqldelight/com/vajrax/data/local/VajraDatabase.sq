-- VAJRAX / HabitFlow offline-first schema (version 2).
-- New columns are always appended at the end of a table so that the CREATE statements
-- here stay column-order compatible with databases upgraded through 1.sqm.
--
-- Domain mapping (see doc/HabitFlow_DocumentAI_Specs/10_SYSTEM_ARCHITECTURE.md):
--   Template        -> TemplateEntity / TemplateHabitEntity (immutable defaults + user custom templates)
--   Tracker         -> UserTemplateEntity (a user's personal copy of a template)
--   Habit           -> PracticeEntity
--   HabitLog        -> ActionRecordEntity (one row per scheduled occurrence, unique per habit + date)

-- 1. USER (local profile, no cloud account in the offline MVP)
CREATE TABLE UserSessionEntity (
    userId TEXT NOT NULL PRIMARY KEY,
    email TEXT NOT NULL,
    displayName TEXT NOT NULL,
    isGuest INTEGER NOT NULL DEFAULT 0,
    activePathId TEXT,
    createdAt TEXT NOT NULL
);

-- 2. LIFE PATHS & PHILOSOPHY
CREATE TABLE LifePathEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    isActive INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE PrincipleEntity (
    id TEXT NOT NULL PRIMARY KEY,
    lifePathId TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    FOREIGN KEY (lifePathId) REFERENCES LifePathEntity(id) ON DELETE CASCADE
);

-- 3. TEMPLATES (provided, community and user custom)
CREATE TABLE TemplateEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    taskCount INTEGER NOT NULL DEFAULT 5,
    frequency TEXT NOT NULL DEFAULT 'Daily',
    author TEXT,
    isCommunity INTEGER NOT NULL DEFAULT 0,
    isBookmarked INTEGER NOT NULL DEFAULT 0,
    isCustom INTEGER NOT NULL DEFAULT 0,
    category TEXT NOT NULL DEFAULT 'General',
    durationDays INTEGER NOT NULL DEFAULT 30,
    isDraft INTEGER NOT NULL DEFAULT 0,
    recommendedFor TEXT,
    updatedAt TEXT
);

CREATE TABLE TemplateHabitEntity (
    id TEXT NOT NULL PRIMARY KEY,
    templateId TEXT NOT NULL,
    name TEXT NOT NULL,
    startTime TEXT NOT NULL,
    durationMinutes INTEGER NOT NULL,
    trackingMode TEXT NOT NULL,
    target TEXT NOT NULL,
    repeatDays TEXT NOT NULL,
    reminderEnabled INTEGER NOT NULL DEFAULT 1,
    sortOrder INTEGER NOT NULL,
    category TEXT,
    icon TEXT,
    color TEXT,
    habitType TEXT NOT NULL DEFAULT 'BOOLEAN',
    targetValue REAL NOT NULL DEFAULT 1,
    unit TEXT,
    scheduleType TEXT NOT NULL DEFAULT 'DAILY',
    weeklyTarget INTEGER NOT NULL DEFAULT 0,
    intervalDays INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (templateId) REFERENCES TemplateEntity(id) ON DELETE CASCADE
);

-- 4. TRACKERS (personal copy of a template)
CREATE TABLE UserTemplateEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    templateId TEXT NOT NULL,
    currentDay INTEGER NOT NULL DEFAULT 1,
    totalDays INTEGER NOT NULL DEFAULT 30,
    progressPercent INTEGER NOT NULL DEFAULT 0,
    isActive INTEGER NOT NULL DEFAULT 1,
    name TEXT,
    startDate TEXT,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    endedAt TEXT,
    FOREIGN KEY (templateId) REFERENCES TemplateEntity(id) ON DELETE CASCADE
);

-- 5. HABITS (PracticeEntity)
CREATE TABLE PracticeEntity (
    id TEXT NOT NULL PRIMARY KEY,
    principleId TEXT,
    title TEXT NOT NULL,
    targetDurationMinutes INTEGER NOT NULL,
    minimumDurationMinutes INTEGER NOT NULL,
    preferredTime TEXT, -- "HH:mm"
    trackingMode TEXT NOT NULL, -- 'MANUAL', 'PASSIVE', 'TIMER', 'HYBRID'
    isActive INTEGER NOT NULL DEFAULT 1,
    trackerId TEXT,
    category TEXT NOT NULL DEFAULT 'General',
    icon TEXT NOT NULL DEFAULT 'check',
    color TEXT NOT NULL DEFAULT 'indigo',
    habitType TEXT NOT NULL DEFAULT 'BOOLEAN', -- BOOLEAN | COUNT | DURATION | VALUE
    targetValue REAL NOT NULL DEFAULT 1,
    unit TEXT,
    scheduleType TEXT NOT NULL DEFAULT 'DAILY', -- DAILY | WEEKDAYS | WEEKLY_TARGET | INTERVAL
    scheduleDays TEXT NOT NULL DEFAULT '1,2,3,4,5,6,7', -- ISO day numbers, 1 = Monday
    weeklyTarget INTEGER NOT NULL DEFAULT 0,
    intervalDays INTEGER NOT NULL DEFAULT 1,
    reminderEnabled INTEGER NOT NULL DEFAULT 0,
    reminderTime TEXT,
    startDate TEXT, -- "YYYY-MM-DD"
    archivedAt TEXT, -- "YYYY-MM-DD", not scheduled from this date on
    sortOrder INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT,
    FOREIGN KEY (principleId) REFERENCES PrincipleEntity(id) ON DELETE SET NULL
);

-- 6. HABIT LOGS (one row per scheduled occurrence)
CREATE TABLE ActionRecordEntity (
    id TEXT NOT NULL PRIMARY KEY,
    practiceId TEXT NOT NULL,
    date TEXT NOT NULL, -- "YYYY-MM-DD" in the user's local time zone
    scheduledTime TEXT, -- "HH:mm"
    status TEXT NOT NULL, -- 'PENDING', 'ONGOING', 'COMPLETE', 'MINIMUM', 'SKIPPED', 'MISSED', 'SNOOZED'
    completedAt TEXT, -- ISO-8601 instant
    durationMinutes INTEGER,
    value REAL,
    note TEXT,
    skipReason TEXT,
    updatedAt TEXT,
    FOREIGN KEY (practiceId) REFERENCES PracticeEntity(id) ON DELETE CASCADE
);

-- 7. EVIDENCE & REFLECTION
CREATE TABLE EvidenceEntity (
    id TEXT NOT NULL PRIMARY KEY,
    actionRecordId TEXT NOT NULL,
    reflectionRating TEXT, -- 'EASY', 'OKAY', 'HARD'
    note TEXT,
    mediaPath TEXT,
    createdAt TEXT NOT NULL,
    FOREIGN KEY (actionRecordId) REFERENCES ActionRecordEntity(id) ON DELETE CASCADE
);

-- 8. BOOK -> LIFE
CREATE TABLE BookIdeaEntity (
    id TEXT NOT NULL PRIMARY KEY,
    bookTitle TEXT NOT NULL,
    author TEXT NOT NULL,
    idea TEXT NOT NULL,
    practicalApplication TEXT NOT NULL,
    isExperimentActive INTEGER NOT NULL DEFAULT 0,
    experimentDaysLeft INTEGER,
    createdAt TEXT NOT NULL
);

-- 9. PATTERNS
CREATE TABLE PatternInsightEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    recommendation TEXT NOT NULL,
    isApplied INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL
);

-- 10. SETTINGS (key/value preferences)
CREATE TABLE SettingEntity (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- 11. GOALS
CREATE TABLE GoalEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    targetType TEXT NOT NULL DEFAULT 'COMPLETIONS', -- COMPLETIONS | RATE
    targetValue REAL NOT NULL,
    startDate TEXT NOT NULL,
    endDate TEXT,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    createdAt TEXT NOT NULL
);

CREATE TABLE GoalHabitEntity (
    goalId TEXT NOT NULL,
    habitId TEXT NOT NULL,
    contributionWeight REAL NOT NULL DEFAULT 1,
    PRIMARY KEY (goalId, habitId)
);

-- 12. REFLECTIONS (weekly / monthly review)
CREATE TABLE ReflectionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    periodType TEXT NOT NULL, -- WEEK | MONTH
    periodStart TEXT NOT NULL,
    achievements TEXT NOT NULL DEFAULT '',
    obstacles TEXT NOT NULL DEFAULT '',
    nextActions TEXT NOT NULL DEFAULT '',
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

-- ==========================================
-- INDEXES
-- ==========================================
CREATE INDEX idx_action_date ON ActionRecordEntity(date);
CREATE INDEX idx_action_practice ON ActionRecordEntity(practiceId);
CREATE INDEX idx_practice_active ON PracticeEntity(isActive);
CREATE INDEX idx_principle_path ON PrincipleEntity(lifePathId);
CREATE INDEX idx_evidence_record ON EvidenceEntity(actionRecordId);
CREATE INDEX idx_template_community ON TemplateEntity(isCommunity);
CREATE INDEX idx_template_habit_tid ON TemplateHabitEntity(templateId);
CREATE INDEX idx_user_template_user ON UserTemplateEntity(userId);
CREATE UNIQUE INDEX idx_action_practice_date ON ActionRecordEntity(practiceId, date);
CREATE INDEX idx_action_status ON ActionRecordEntity(status);
CREATE INDEX idx_practice_tracker ON PracticeEntity(trackerId);
CREATE UNIQUE INDEX idx_reflection_period ON ReflectionEntity(periodType, periodStart);

-- ==========================================
-- SYNC (schema v3): change capture for cloud backup and sync.
-- While signed in, triggers (installed at runtime by SyncTriggers.kt, because SQLDelight
-- cannot compile trigger bodies that use NEW/OLD) note every changed record in SyncOutbox;
-- the sync engine uploads them and applies downloaded records with SyncState.applying = 1.
-- ==========================================

CREATE TABLE SyncOutbox (
    entity TEXT NOT NULL,
    entityId TEXT NOT NULL,
    changedAt INTEGER NOT NULL, -- epoch ms of the latest local change
    PRIMARY KEY (entity, entityId)
);

CREATE TABLE SyncMeta (
    entity TEXT NOT NULL,
    entityId TEXT NOT NULL,
    updatedAt INTEGER NOT NULL, -- change time of the version this device has
    version INTEGER NOT NULL,   -- server version of that change
    PRIMARY KEY (entity, entityId)
);

CREATE TABLE SyncState (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    enabled INTEGER NOT NULL DEFAULT 0,  -- 1 while signed in
    applying INTEGER NOT NULL DEFAULT 0, -- 1 while writing downloaded records
    cursor INTEGER NOT NULL DEFAULT 0,   -- last server version pulled
    deviceId TEXT NOT NULL,
    lastSyncAt INTEGER
);


-- ==========================================
-- QUERIES
-- ==========================================

-- Settings
getSetting:
SELECT value FROM SettingEntity WHERE key = ?;

putSetting:
INSERT OR REPLACE INTO SettingEntity(key, value) VALUES (?, ?);

getAllSettings:
SELECT * FROM SettingEntity;

-- User
insertOrUpdateUser:
INSERT OR REPLACE INTO UserSessionEntity(userId, email, displayName, isGuest, activePathId, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

getCurrentUser:
SELECT * FROM UserSessionEntity LIMIT 1;

updateUserProfile:
UPDATE UserSessionEntity SET displayName = ?, email = ? WHERE userId = ?;

clearUserSession:
DELETE FROM UserSessionEntity;

-- Life Paths
insertLifePath:
INSERT OR REPLACE INTO LifePathEntity(id, name, description, isActive)
VALUES (?, ?, ?, ?);

getAllLifePaths:
SELECT * FROM LifePathEntity;

getActiveLifePath:
SELECT * FROM LifePathEntity WHERE isActive = 1 LIMIT 1;

setActiveLifePath:
UPDATE LifePathEntity SET isActive = CASE WHEN id = ? THEN 1 ELSE 0 END;

insertPrinciple:
INSERT OR REPLACE INTO PrincipleEntity(id, lifePathId, title, description)
VALUES (?, ?, ?, ?);

getPrinciplesForPath:
SELECT * FROM PrincipleEntity WHERE lifePathId = ?;

-- Templates
insertTemplate:
INSERT OR REPLACE INTO TemplateEntity(id, title, description, taskCount, frequency, author, isCommunity, isBookmarked, isCustom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertTemplate:
INSERT OR REPLACE INTO TemplateEntity(id, title, description, taskCount, frequency, author, isCommunity, isBookmarked, isCustom, category, durationDays, isDraft, recommendedFor, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllTemplates:
SELECT * FROM TemplateEntity WHERE isDraft = 0 ORDER BY isCustom DESC, isCommunity ASC, title ASC;

getProvidedTemplates:
SELECT * FROM TemplateEntity WHERE isCommunity = 0 AND isCustom = 0;

getCommunityTemplates:
SELECT * FROM TemplateEntity WHERE isCommunity = 1;

getCustomTemplates:
SELECT * FROM TemplateEntity WHERE isCustom = 1 ORDER BY updatedAt DESC;

getTemplateById:
SELECT * FROM TemplateEntity WHERE id = ? LIMIT 1;

toggleTemplateBookmark:
UPDATE TemplateEntity SET isBookmarked = ? WHERE id = ?;

updateTemplate:
UPDATE TemplateEntity
SET title = ?, description = ?, taskCount = ?, frequency = ?
WHERE id = ?;

deleteTemplate:
DELETE FROM TemplateEntity WHERE id = ?;

deleteSystemTemplates:
DELETE FROM TemplateEntity WHERE isCustom = 0;

-- Template Habits
insertTemplateHabit:
INSERT OR REPLACE INTO TemplateHabitEntity(id, templateId, name, startTime, durationMinutes, trackingMode, target, repeatDays, reminderEnabled, sortOrder, category, icon, color, habitType, targetValue, unit, scheduleType, weeklyTarget, intervalDays)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getHabitsForTemplate:
SELECT * FROM TemplateHabitEntity WHERE templateId = ? ORDER BY sortOrder ASC;

getAllTemplateHabits:
SELECT * FROM TemplateHabitEntity ORDER BY templateId, sortOrder ASC;

deleteTemplateHabits:
DELETE FROM TemplateHabitEntity WHERE templateId = ?;

deleteSystemTemplateHabits:
DELETE FROM TemplateHabitEntity WHERE templateId IN (SELECT id FROM TemplateEntity WHERE isCustom = 0);

-- Trackers
insertTracker:
INSERT OR REPLACE INTO UserTemplateEntity(id, userId, templateId, currentDay, totalDays, progressPercent, isActive, name, startDate, status, endedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getActiveTracker:
SELECT * FROM UserTemplateEntity WHERE isActive = 1 LIMIT 1;

getAllTrackers:
SELECT * FROM UserTemplateEntity ORDER BY isActive DESC, startDate DESC;

getTrackerById:
SELECT * FROM UserTemplateEntity WHERE id = ? LIMIT 1;

archiveActiveTrackers:
UPDATE UserTemplateEntity SET isActive = 0, status = 'ARCHIVED', endedAt = ? WHERE isActive = 1;

renameTracker:
UPDATE UserTemplateEntity SET name = ? WHERE id = ?;

moveTrackerStart:
UPDATE UserTemplateEntity SET startDate = ? WHERE id = ?;

-- Habits of a routine that hasn't started yet begin with it; habits already running keep their date.
moveTrackerHabitsStart:
UPDATE PracticeEntity SET startDate = :date WHERE trackerId = :trackerId AND startDate > :date;

insertOrUpdateUserTemplate:
INSERT OR REPLACE INTO UserTemplateEntity(id, userId, templateId, currentDay, totalDays, progressPercent, isActive)
VALUES (?, ?, ?, ?, ?, ?, ?);

getActiveUserTemplate:
SELECT
    UserTemplateEntity.id,
    UserTemplateEntity.userId,
    UserTemplateEntity.templateId,
    UserTemplateEntity.currentDay,
    UserTemplateEntity.totalDays,
    UserTemplateEntity.progressPercent,
    UserTemplateEntity.isActive,
    TemplateEntity.title,
    TemplateEntity.description
FROM UserTemplateEntity
JOIN TemplateEntity ON UserTemplateEntity.templateId = TemplateEntity.id
WHERE UserTemplateEntity.isActive = 1
LIMIT 1;

-- Habits (PracticeEntity)
insertPractice:
INSERT OR REPLACE INTO PracticeEntity(id, principleId, title, targetDurationMinutes, minimumDurationMinutes, preferredTime, trackingMode, isActive)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertHabit:
INSERT OR REPLACE INTO PracticeEntity(id, principleId, title, targetDurationMinutes, minimumDurationMinutes, preferredTime, trackingMode, isActive, trackerId, category, icon, color, habitType, targetValue, unit, scheduleType, scheduleDays, weeklyTarget, intervalDays, reminderEnabled, reminderTime, startDate, archivedAt, sortOrder, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateHabit:
UPDATE PracticeEntity
SET title = ?, targetDurationMinutes = ?, minimumDurationMinutes = ?, preferredTime = ?, trackingMode = ?,
    category = ?, icon = ?, color = ?, habitType = ?, targetValue = ?, unit = ?,
    scheduleType = ?, scheduleDays = ?, weeklyTarget = ?, intervalDays = ?,
    reminderEnabled = ?, reminderTime = ?, startDate = ?
WHERE id = ?;

archiveHabit:
UPDATE PracticeEntity SET isActive = 0, archivedAt = ? WHERE id = ?;

archiveHabitsForTracker:
UPDATE PracticeEntity SET isActive = 0, archivedAt = ? WHERE trackerId = ? AND archivedAt IS NULL;

updateHabitSortOrder:
UPDATE PracticeEntity SET sortOrder = ? WHERE id = ?;

getHabitById:
SELECT * FROM PracticeEntity WHERE id = ? LIMIT 1;

getHabitsForTracker:
SELECT * FROM PracticeEntity
WHERE trackerId = ? AND archivedAt IS NULL
ORDER BY preferredTime ASC, sortOrder ASC;

getTrackedHabits:
SELECT * FROM PracticeEntity WHERE coalesce(trackerId, '') <> '';

getAllPractices:
SELECT * FROM PracticeEntity;

getActivePractices:
SELECT * FROM PracticeEntity WHERE isActive = 1;

togglePracticeActive:
UPDATE PracticeEntity SET isActive = ? WHERE id = ?;

-- Habit logs / occurrences
insertActionRecord:
INSERT OR REPLACE INTO ActionRecordEntity(id, practiceId, date, scheduledTime, status, completedAt, durationMinutes)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertOccurrenceIfAbsent:
INSERT OR IGNORE INTO ActionRecordEntity(id, practiceId, date, scheduledTime, status, updatedAt)
VALUES (?, ?, ?, ?, 'PENDING', ?);

getOccurrenceById:
SELECT * FROM ActionRecordEntity WHERE id = ? LIMIT 1;

getOccurrence:
SELECT * FROM ActionRecordEntity WHERE practiceId = ? AND date = ? LIMIT 1;

updateCheckIn:
UPDATE ActionRecordEntity
SET status = ?, completedAt = ?, durationMinutes = ?, value = ?, skipReason = NULL, updatedAt = ?
WHERE id = ?;

updateSkip:
UPDATE ActionRecordEntity
SET status = 'SKIPPED', skipReason = ?, completedAt = NULL, updatedAt = ?
WHERE id = ?;

updateOccurrenceTime:
UPDATE ActionRecordEntity SET scheduledTime = ?, status = ?, updatedAt = ? WHERE id = ?;

updateOccurrenceNote:
UPDATE ActionRecordEntity SET note = ?, updatedAt = ? WHERE id = ?;

updatePendingOccurrenceTime:
UPDATE ActionRecordEntity SET scheduledTime = ?
WHERE practiceId = ? AND date = ? AND status IN ('PENDING', 'SNOOZED');

deletePendingOccurrence:
DELETE FROM ActionRecordEntity
WHERE practiceId = ? AND date >= ? AND status IN ('PENDING', 'SNOOZED', 'ONGOING');

deletePendingOccurrencesForTracker:
DELETE FROM ActionRecordEntity
WHERE date >= ? AND status IN ('PENDING', 'SNOOZED', 'ONGOING')
  AND practiceId IN (SELECT id FROM PracticeEntity WHERE trackerId = ?);

updateActionStatus:
UPDATE ActionRecordEntity
SET status = ?, completedAt = ?, durationMinutes = ?
WHERE id = ?;

getTimelineForDate:
SELECT * FROM ActionRecordEntity
WHERE date = ?
ORDER BY scheduledTime ASC;

getRecordsBetween:
SELECT * FROM ActionRecordEntity
WHERE date >= ? AND date <= ?
ORDER BY date ASC, scheduledTime ASC;

getRecordsForHabitSince:
SELECT * FROM ActionRecordEntity
WHERE practiceId = ? AND date >= ?
ORDER BY date ASC;

getTodayTimeline:
SELECT
    ActionRecordEntity.id,
    ActionRecordEntity.practiceId,
    ActionRecordEntity.date,
    ActionRecordEntity.scheduledTime,
    ActionRecordEntity.status,
    ActionRecordEntity.completedAt,
    ActionRecordEntity.durationMinutes,
    PracticeEntity.title,
    PracticeEntity.targetDurationMinutes,
    PracticeEntity.minimumDurationMinutes,
    PracticeEntity.trackingMode
FROM ActionRecordEntity
JOIN PracticeEntity ON ActionRecordEntity.practiceId = PracticeEntity.id
WHERE ActionRecordEntity.date = ?
ORDER BY ActionRecordEntity.scheduledTime ASC;

getActionRecordsBetweenDates:
SELECT * FROM ActionRecordEntity
WHERE date >= ? AND date <= ?;

earliestRecordDate:
SELECT MIN(date) AS minDate FROM ActionRecordEntity;

countCompletedActionsBetweenDates:
SELECT COUNT(*) FROM ActionRecordEntity
WHERE date >= ? AND date <= ? AND (status = 'COMPLETE' OR status = 'MINIMUM');

countTotalActionsBetweenDates:
SELECT COUNT(*) FROM ActionRecordEntity
WHERE date >= ? AND date <= ?;

-- Evidence
insertEvidence:
INSERT OR REPLACE INTO EvidenceEntity(id, actionRecordId, reflectionRating, note, mediaPath, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

getAllEvidence:
SELECT * FROM EvidenceEntity ORDER BY createdAt DESC;

getRecentEvidence:
SELECT
    EvidenceEntity.id,
    EvidenceEntity.actionRecordId,
    EvidenceEntity.reflectionRating,
    EvidenceEntity.note,
    EvidenceEntity.mediaPath,
    EvidenceEntity.createdAt,
    ActionRecordEntity.date,
    ActionRecordEntity.durationMinutes,
    PracticeEntity.title AS practiceTitle
FROM EvidenceEntity
JOIN ActionRecordEntity ON EvidenceEntity.actionRecordId = ActionRecordEntity.id
JOIN PracticeEntity ON ActionRecordEntity.practiceId = PracticeEntity.id
ORDER BY EvidenceEntity.createdAt DESC
LIMIT ?;

-- Book Ideas & Experiments
insertBookIdea:
INSERT OR REPLACE INTO BookIdeaEntity(id, bookTitle, author, idea, practicalApplication, isExperimentActive, experimentDaysLeft, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getAllBookIdeas:
SELECT * FROM BookIdeaEntity ORDER BY createdAt DESC;

updateExperimentStatus:
UPDATE BookIdeaEntity
SET isExperimentActive = ?, experimentDaysLeft = ?, practicalApplication = ?
WHERE id = ?;

-- Pattern Insights
insertPatternInsight:
INSERT OR REPLACE INTO PatternInsightEntity(id, title, description, recommendation, isApplied, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

getActivePatternInsights:
SELECT * FROM PatternInsightEntity WHERE isApplied = 0 ORDER BY createdAt DESC;

markPatternInsightApplied:
UPDATE PatternInsightEntity SET isApplied = 1 WHERE id = ?;

-- Goals
upsertGoal:
INSERT OR REPLACE INTO GoalEntity(id, title, description, targetType, targetValue, startDate, endDate, status, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getGoals:
SELECT * FROM GoalEntity ORDER BY status ASC, createdAt DESC;

deleteGoal:
DELETE FROM GoalEntity WHERE id = ?;

insertGoalHabit:
INSERT OR REPLACE INTO GoalHabitEntity(goalId, habitId, contributionWeight) VALUES (?, ?, ?);

deleteGoalHabits:
DELETE FROM GoalHabitEntity WHERE goalId = ?;

getAllGoalHabits:
SELECT * FROM GoalHabitEntity;

-- Reflections
upsertReflection:
INSERT OR REPLACE INTO ReflectionEntity(id, periodType, periodStart, achievements, obstacles, nextActions, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getReflection:
SELECT * FROM ReflectionEntity WHERE periodType = ? AND periodStart = ? LIMIT 1;

getAllReflections:
SELECT * FROM ReflectionEntity ORDER BY periodStart DESC;

-- Delete all personal data (templates library is re-seeded, custom templates removed)
wipePersonalData {
    DELETE FROM EvidenceEntity;
    DELETE FROM ActionRecordEntity;
    DELETE FROM PracticeEntity;
    DELETE FROM UserTemplateEntity;
    DELETE FROM GoalHabitEntity;
    DELETE FROM GoalEntity;
    DELETE FROM ReflectionEntity;
    DELETE FROM TemplateHabitEntity WHERE templateId IN (SELECT id FROM TemplateEntity WHERE isCustom = 1);
    DELETE FROM TemplateEntity WHERE isCustom = 1;
    DELETE FROM UserSessionEntity;
    DELETE FROM BookIdeaEntity;
    DELETE FROM PatternInsightEntity;
    -- Keep the library version, and the scheduled-reminder ids so the next sync can cancel those alarms.
    DELETE FROM SettingEntity WHERE key NOT IN ('template_library_version', 'reminder_scheduled_ids');
    UPDATE LifePathEntity SET isActive = 0;
}

-- Sync
syncState:
SELECT * FROM SyncState WHERE id = 1;

syncStateInit:
INSERT OR IGNORE INTO SyncState(id, enabled, applying, cursor, deviceId) VALUES (1, 0, 0, 0, ?);

syncSetEnabled:
UPDATE SyncState SET enabled = ? WHERE id = 1;

syncSetApplying:
UPDATE SyncState SET applying = ? WHERE id = 1;

syncSetCursor:
UPDATE SyncState SET cursor = ? WHERE id = 1;

syncSetLastSync:
UPDATE SyncState SET lastSyncAt = ? WHERE id = 1;

-- A fresh id per sign-in, so a database restored onto another phone never shares one.
syncSetDeviceId:
UPDATE SyncState SET deviceId = ? WHERE id = 1;

outboxCount:
SELECT count(*) FROM SyncOutbox;

outboxBatch:
SELECT * FROM SyncOutbox ORDER BY changedAt, entity, entityId LIMIT ?;

outboxChangedAt:
SELECT changedAt FROM SyncOutbox WHERE entity = ? AND entityId = ?;

outboxRemoveIfUnchanged:
DELETE FROM SyncOutbox WHERE entity = ? AND entityId = ? AND changedAt = ?;

outboxRemove:
DELETE FROM SyncOutbox WHERE entity = ? AND entityId = ?;

outboxClear:
DELETE FROM SyncOutbox;

-- Queues everything already on the device (first sign-in uploads the existing history).
outboxSnapshot {
    INSERT OR REPLACE INTO SyncOutbox SELECT 'tracker', id, :now FROM UserTemplateEntity;
    INSERT OR REPLACE INTO SyncOutbox SELECT 'habit', id, :now FROM PracticeEntity WHERE trackerId IS NOT NULL;
    INSERT OR REPLACE INTO SyncOutbox SELECT 'occurrence', id, :now FROM ActionRecordEntity WHERE status <> 'PENDING';
    INSERT OR REPLACE INTO SyncOutbox SELECT 'goal', id, :now FROM GoalEntity;
    INSERT OR REPLACE INTO SyncOutbox SELECT 'reflection', id, :now FROM ReflectionEntity;
    INSERT OR REPLACE INTO SyncOutbox SELECT 'template', id, :now FROM TemplateEntity WHERE id LIKE 'custom_%';
    INSERT OR REPLACE INTO SyncOutbox SELECT 'setting', key, :now FROM SettingEntity WHERE key IN ('onboarding_goals', 'wake_time', 'morning_minutes');
}

metaPut:
INSERT OR REPLACE INTO SyncMeta(entity, entityId, updatedAt, version) VALUES (?, ?, ?, ?);

metaUpdatedAt:
SELECT updatedAt FROM SyncMeta WHERE entity = ? AND entityId = ?;

metaClear:
DELETE FROM SyncMeta;

personalRecordCount:
SELECT (SELECT count(*) FROM UserTemplateEntity) + (SELECT count(*) FROM GoalEntity) + (SELECT count(*) FROM ReflectionEntity) AS total;

getActiveTrackers:
SELECT * FROM UserTemplateEntity WHERE isActive = 1;

archiveTracker:
UPDATE UserTemplateEntity SET isActive = 0, status = 'ARCHIVED', endedAt = ? WHERE id = ?;

deleteTrackerById:
DELETE FROM UserTemplateEntity WHERE id = ?;

deleteHabitById:
DELETE FROM PracticeEntity WHERE id = ?;

upsertOccurrence:
INSERT OR REPLACE INTO ActionRecordEntity(id, practiceId, date, scheduledTime, status, completedAt, durationMinutes, value, note, skipReason, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteOccurrenceById:
DELETE FROM ActionRecordEntity WHERE id = ?;

getGoalById:
SELECT * FROM GoalEntity WHERE id = ?;

getGoalHabitIds:
SELECT habitId FROM GoalHabitEntity WHERE goalId = ?;

getReflectionById:
SELECT * FROM ReflectionEntity WHERE id = ?;

deleteReflectionById:
DELETE FROM ReflectionEntity WHERE id = ?;

deleteSetting:
DELETE FROM SettingEntity WHERE key = ?;

-- Removes only what the account holds (first sign-in with "use my account's data");
-- device settings such as theme, reminders and onboarding stay.
wipeSyncedData {
    DELETE FROM ActionRecordEntity;
    DELETE FROM PracticeEntity WHERE trackerId IS NOT NULL;
    DELETE FROM UserTemplateEntity;
    DELETE FROM GoalHabitEntity;
    DELETE FROM GoalEntity;
    DELETE FROM ReflectionEntity;
    DELETE FROM TemplateHabitEntity WHERE templateId LIKE 'custom_%';
    DELETE FROM TemplateEntity WHERE id LIKE 'custom_%';
    DELETE FROM SettingEntity WHERE key IN ('onboarding_goals', 'wake_time', 'morning_minutes');
}
